<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Forward all API calls to Node.js Backend running on port 5000
  RewriteRule ^api/(.*)$ http://127.0.0.1:5000/api/$1 [P,L]

  # 2. SPA Fallback: Serve index.html for all non-file/non-directory requests
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
